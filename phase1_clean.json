{
  "_comment": "Phase 1: 纯像素精度极限优化 | SwinIR-M x2 | 目标 Y-PSNR 37-38 dB",

  "train-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_train_set/x2/HR",
    "/root/autodl-tmp/FLickr2K/x2/HR"
  ],
  "eval-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_eval_set",
    "/root/autodl-tmp/Set14",
    "/root/autodl-tmp/urban",
    "/root/autodl-tmp/bsd300/test"
  ],
  "outputs-dir": "./checkpoints/phase1_pixel/",

  "model": "full",
  "arch": "official",
  "scale": 2,
  "embed-dim": 180,
  "depths": [6, 6, 6, 6, 6, 6],
  "num-heads": [6, 6, 6, 6, 6, 6],
  "window-size": 8,
  "mlp-ratio": 2.0,
  "drop-path-rate": 0.1,
  "pretrained": "./pre/001_classicalSR_DF2K_s64w8_SwinIR-M_x2.pth",

  "patch-size": 192,
  "batch-size": 8,
  "grad-accum": 4,
  "num-workers": 50,
  "num-epochs": 500,

  "lr-schedule": "warmup_cosine",
  "lr": 0.0002,
  "min-lr": 0.000001,
  "warmup-epochs": 10,
  "T-max": 300,

  "w-l1": 1.0,
  "w-ssim": 0.0,
  "w-lpips": 0.0,
  "w-fft": 0.0,
  "w-edge": 0.0,

  "val-w-psnr": 1.0,
  "val-w-ssim": 0.0,
  "val-w-lpips": 0.0,
  "calc-niqe": false,
  "val-w-niqe": 0.0,

  "degradation": "clean",
  "use-ema": true,
  "ema-decay": 0.999,
  "save": "yes",
  "save-seq": 10,
  "val-interval": 5,
  "val-warmup-epochs": 20,
  "early-stop": false,
  "distributed": true
}
