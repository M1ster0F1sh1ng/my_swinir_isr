{
  "_comment": "Phase 1 (Light): 纯像素精度极限优化 | SwinIR-Light x2 | embed=96, 4layers | 目标 Y-PSNR 35.5-36.5 dB",

  "train-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_train_set/x2/HR",
    "/root/autodl-tmp/FLickr2K/x2/HR"
  ],
  "eval-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_eval_set",
    "/root/autodl-tmp/Set14",
    "/root/autodl-tmp/urban",
    "/root/autodl-tmp/bsd300/test"
  ],
  "outputs-dir": "./checkpoints_light/phase1_pixel/",

  "model": "full",
  "arch": "official",
  "scale": 2,
  "embed-dim": 96,
  "depths": [6, 6, 6, 6],
  "num-heads": [6, 6, 6, 6],
  "window-size": 8,
  "mlp-ratio": 2.0,
  "drop-path-rate": 0.05,
  "pretrained": "",

  "patch-size": 128,
  "batch-size": 16,
  "grad-accum": 2,
  "num-workers": 50,
  "num-epochs": 400,

  "lr-schedule": "warmup_cosine",
  "lr": 0.0003,
  "min-lr": 0.000001,
  "warmup-epochs": 10,
  "T-max": 250,

  "w-l1": 1.0,
  "w-ssim": 0.0,
  "w-lpips": 0.0,
  "w-fft": 0.0,
  "w-edge": 0.0,

  "val-w-psnr": 1.0,
  "val-w-ssim": 0.0,
  "val-w-lpips": 0.0,

  "degradation": "clean",
  "use-ema": true,
  "ema-decay": 0.999,
  "early-stop": false,
  "distributed": true
}
