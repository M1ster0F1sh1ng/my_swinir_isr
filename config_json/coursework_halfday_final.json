{
  "train-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_train_set/x2/HR",
    "/root/autodl-tmp/FLickr2K/x2/HR"
  ],
  "eval-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_eval_set",
    "/root/autodl-tmp/Set14",
    "/root/autodl-tmp/urban",
    "/root/autodl-tmp/bsd300/test"
  ],
  "model": "light",
  "arch": "official",
  "window-size": 8,
  "mlp-ratio": 2.0,
  "upsampler": "pixelshuffle",
  "use-ema": true,
  "ema-decay": 0.999,
  "save": "yes",
  "save-seq": 10,
  "early-stop": true,
  "es-patience": 15,
  "es-min-epochs": 60,
  "es-min-delta": 0.0001,
  "distributed": true,
  "num-workers": 50,
  "lr-schedule": "warmup_cosine",
  "min-lr": 1e-07,
  "_comment_loss": "半天方案：L1绝对主导保PSNR，SSIM辅助，不加LPIPS",
  "w-l1": 1.0,
  "w-ssim": 0.2,
  "w-lpips": 0.0,
  "w-fft": 0.1,
  "w-edge": 0.0,
  "w-mscn": 0.0,
  "val-w-psnr": 1.0,
  "val-w-ssim": 0.0,
  "val-w-lpips": 0.0,
  "calc-niqe": false,
  "val-w-niqe": 0.0,
  "degradation": "mild",
  "val-interval": 5,
  "val-warmup-epochs": 10,
  "_comment": "Half-Day: Light模型+轻度second_order退化+L1主导+从light预训练微调",
  "outputs-dir": "./checkpoints/coursework_halfday/",
  "scale": 2,
  "embed-dim": 60,
  "depths": [
    6,
    6,
    6,
    6
  ],
  "num-heads": [
    6,
    6,
    6,
    6
  ],
  "drop-path-rate": 0.1,
  "_comment_pretrained": "light模型官方参数: embed_dim=60, depths=[6,6,6,6], num_heads=[6,6,6,6]",
  "pretrained": "./weights/swinir_light_x2_192.pth",
  "patch-size": 192,
  "batch-size": 8,
  "grad-accum": 4,
  "num-epochs": 150,
  "lr": 0.0001,
  "warmup-epochs": 5,
  "T-max": 150
}