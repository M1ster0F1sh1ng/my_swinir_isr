{
  "train-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_train_set/x2/HR",
    "/root/autodl-tmp/FLickr2K/x2/HR" ,
    "/root/autodl-tmp/bsd300/train"
  ],
  "eval-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_eval_set",
    "/root/autodl-tmp/Set14",
    "/root/autodl-tmp/urban",
    "/root/autodl-tmp/bsd300/test"
  ],
  "model": "light",
  "arch": "official",
  "window-size": 8,
  "mlp-ratio": 2.0,
  "upsampler": "pixelshuffledirect",
  "use-ema": true,
  "ema-decay": 0.999,
  "save": "yes",
  "save-seq": 10,
  "early-stop": false,
  "distributed": true,
  "num-workers": 24,
  "lr-schedule": "warmup_cosine",
  "min-lr": 1e-06,
  "w-l1": 1.0,
  "w-ssim": 0.5,
  "w-lpips": 0.0,
  "w-fft": 0.0,
  "w-edge": 0.0,
  "val-w-psnr": 1.0,
  "val-w-ssim": 0.0,
  "val-w-lpips": 0.0,
  "calc-niqe": false,
  "val-w-niqe": 0.0,
  "degradation": "second_order",
  "val-interval": 1,
  "val-warmup-epochs": 50,
  "stage1-epochs": 400,
