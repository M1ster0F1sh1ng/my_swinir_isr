  "outputs-dir": "./checkpoints_light/coursework_final/",
  "scale": 2,
  "embed-dim": 60,
  "depths": [6, 6, 6, 6],
  "num-heads": [6, 6, 6, 6],
  "drop-path-rate": 0.05,
  "pretrained": "./pre/002_lightweightSR_DIV2K_s64w8_SwinIR-S_x2.pth",
  "patch-size": 192,
  "batch-size": 32,
  "grad-accum": 2,
  "num-epochs": 400,
  "lr": 0.0003,
  "warmup-epochs": 10,
  "T-max": 400
}
