{
  "_comment": "Phase 3: Perceptual Optimization — 在抗退化基础上优化视觉质量",

  "train-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_train_set/x2/HR",
    "/root/autodl-tmp/FLickr2K/x2/HR",
    "/root/autodl-tmp/bsd300/train"
  ],
  "eval-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_eval_set",
    "/root/autodl-tmp/Set14",
    "/root/autodl-tmp/urban",
    "/root/autodl-tmp/bsd300/test"
  ],
  "outputs-dir": "./checkpoints/phase3_perceptual/",

  "model": "full",
  "arch": "official",
  "scale": 2,
  "embed-dim": 180,
  "depths": [6, 6, 6, 6, 6, 6],
  "num-heads": [6, 6, 6, 6, 6, 6],
  "mlp-ratio": 2.0,
  "drop-path-rate": 0.1,
  "pretrained": "./pre/001_classicalSR_DF2K_s64w8_SwinIR-M_x2.pth",

  "patch-size": 96,
  "batch-size": 28,
  "grad-accum": 1,
  "num-workers": 50,
  "num-epochs": 200,

  "lr-schedule": "warmup_cosine",
  "lr": 0.0001,
  "min-lr": 0.000001,
  "warmup-epochs": 3,
  "T-max": 100,

  "w-l1": 0.5,
  "w-ssim": 0.3,
  "w-lpips": 0.3,

  "val-w-psnr": 1.0,
  "val-w-ssim": 0.5,
  "val-w-lpips": 0.5,

  "stage1-epochs": 50,
  "transition-epochs": 20,
  "degradation": "second_order",

  "use-ema": true,
  "ema-decay": 0.999,
  "early-stop": true,
  "es-patience": 20,
  "es-min-epochs": 50,

  "distributed": true
}