{
  "_comment": "Phase 3: 感知质量优化 | 承接 Phase2 抗退化能力 | 引入 LPIPS/FFT/Edge 提升视觉",

  "train-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_train_set/x2/HR",
    "/root/autodl-tmp/FLickr2K/x2/HR"
  ],
  "eval-file": [
    "/root/autodl-tmp/DIV2K/DIV2K_eval_set",
    "/root/autodl-tmp/Set14",
    "/root/autodl-tmp/urban",
    "/root/autodl-tmp/bsd300/test"
  ],
  "outputs-dir": "./checkpoints/phase3_perceptual/",

  "model": "full",
  "arch": "official",
  "scale": 2,
  "embed-dim": 180,
  "depths": [6, 6, 6, 6, 6, 6],
  "num-heads": [6, 6, 6, 6, 6, 6],
  "window-size": 8,
  "mlp-ratio": 2.0,
  "drop-path-rate": 0.1,
  "pretrained": "./checkpoints/phase2_degrade/full_swinir_fixed_x2/0004/checkpoint_best.pth",

  "patch-size": 192,
  "batch-size": 8,
  "grad-accum": 4,
  "num-workers": 50,
  "num-epochs": 200,

  "lr-schedule": "warmup_cosine",
  "lr": 0.0001,
  "min-lr": 0.000001,
  "warmup-epochs": 3,
  "T-max": 150,

  "w-l1": 0.3,
  "w-ssim": 0.3,
  "w-lpips": 0.3,
  "w-fft": 0.5,
  "w-edge": 0.2,

  "val-w-psnr": 1.0,
  "val-w-ssim": 0.5,
  "val-w-lpips": 0.5,

  "degradation": "second_order",

  "use-ema": true,
  "ema-decay": 0.999,
  "early-stop": false,
  "distributed": true
}
